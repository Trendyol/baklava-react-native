{
  "name": "@trendyol/baklava-react-native",
  "version": "0.0.0-dev",
  "description": "Trendyol Baklava Design System for React Native",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "react-native": "src/index.ts",
  "types": "lib/typescript/src/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "author": {
    "name": "Trendyol Tech",
    "url": "https://github.com/Trendyol"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Trendyol/baklava-react-native.git"
  },
  "license": "MIT",
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:watch:cov": "jest --watch --coverage",
    "test:cov": "jest --coverage",
    "lint": "npm-run-all -s lint:*",
    "lint:eslint": "eslint -c .eslintrc.js --ext .ts,.tsx",
    "lint:tsc": "tsc --noEmit",
    "lint:prettier": "prettier --check src/",
    "format": "eslint -c .eslintrc.js --fix && prettier --write .",
    "commit": "commit",
    "release": "semantic-release",
    "storybook": "storybook dev -c docs/.storybook -p 6006",
    "build-storybook-docs": "storybook build -c docs/.storybook",
    "storybook-generate": "sb-rn-get-stories -c .rnstorybook",
    "build": "bob build",
    "pod": "cd ios; pod install; cd ..;",
    "prepare": "npm run storybook-generate && bob build && husky install",
    "svgr": "svgr ./src/svg-icons -d ./src/icons --icon --native --typescript --svgo-config svgo.config.js --ignore-existing --replace-attr-values '#273142={props?.fill ?? `#273142`}'"
  },
  "dependencies": {
    "@ergenekonyigit/restyle": "2.4.0-1ec4a08.3",
    "@gorhom/portal": "^1.0.14",
    "@shopify/restyle": "2.3.0",
    "styled-components": "5.3.0",
    "styled-system": "5.1.5"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@commitlint/cli": "17.1.2",
    "@commitlint/config-conventional": "17.1.0",
    "@commitlint/prompt-cli": "17.1.2",
    "@react-native-async-storage/async-storage": "^2.1.0",
    "@react-native-community/cli": "15.0.1",
    "@react-native-community/cli-platform-android": "15.0.1",
    "@react-native-community/cli-platform-ios": "15.0.1",
    "@react-native-community/datetimepicker": "^8.2.0",
    "@react-native-community/slider": "^4.5.5",
    "@react-native/babel-preset": "0.77.3",
    "@react-native/eslint-config": "0.77.3",
    "@react-native/metro-config": "0.77.3",
    "@react-native/typescript-config": "0.77.3",
    "@gorhom/bottom-sheet": "^5.1.2",
    "@storybook/addon-docs": "9.1.4",
    "@storybook/addon-links": "9.1.4",
    "@storybook/addon-ondevice-actions": "9.1.4",
    "@storybook/addon-ondevice-backgrounds": "9.1.4",
    "@storybook/addon-ondevice-controls": "9.1.4",
    "@storybook/addon-ondevice-notes": "9.1.4",
    "@storybook/react": "9.1.4",
    "@storybook/react-native": "9.1.4",
    "@storybook/react-webpack5": "9.1.4",
    "@svgr/cli": "6.3.1",
    "@testing-library/jest-native": "4.0.5",
    "@testing-library/react-hooks": "^8.0.1",
    "@testing-library/react-native": "10.1.1",
    "@types/jest": "^26.0.23",
    "@types/react": "^18.2.6",
    "@types/react-test-renderer": "^18.0.0",
    "@types/styled-components-react-native": "5.1.3",
    "@types/styled-system": "5.1.12",
    "@typescript-eslint/eslint-plugin": "^5.7.0",
    "@typescript-eslint/parser": "^5.7.0",
    "@welldone-software/why-did-you-render": "^7.0.1",
    "babel-jest": "^29.6.3",
    "babel-loader": "^8.2.5",
    "eslint": "^8.19.0",
    "eslint-config-prettier": "8.5.0",
    "eslint-plugin-import": "2.26.0",
    "eslint-plugin-storybook": "^0.12.0",
    "husky": "8.0.1",
    "jest": "^29.6.3",
    "lint-staged": "13.0.3",
    "npm-run-all": "4.1.5",
    "prettier": "2.8.8",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.77.3",
    "react-native-builder-bob": "^0.35.2",
    "react-native-gesture-handler": "2.27.2",
    "react-native-reanimated": "3.17.5",
    "react-native-safe-area-context": "^5.4.0",
    "react-native-svg": "15.12.1",
    "react-test-renderer": "18.3.1",
    "semantic-release": "^25.0.5",
    "storybook": "9.1.4",
    "typescript": "5.0.4",
    "webpack": "^5.99.0"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "react-native-svg": "*"
  },
  "engines": {
    "node": ">=18"
  },
  "resolutions": {
    "@types/react": "^18"
  },
  "overrides": {
    "react-native-gesture-handler": "2.27.2",
    "react-native-reanimated": "3.17.5",
    "react-native-svg": "15.12.1"
  },
  "jest": {
    "preset": "react-native",
    "globalSetup": "<rootDir>/jest.setup.js",
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json",
      "node"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/lib/"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(jest-)?react-native|@react-native|react-clone-referenced-element|@react-native-community|expo(nent)?|@expo(nent)?/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base)"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/__mocks__/globalMock.js"
    ],
    "collectCoverageFrom": [
      "src/components/**",
      "!src/components/**/*.stories.tsx",
      "!src/components/**/types.ts",
      "!src/components/**/__snapshots__/**"
    ]
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      "typescript"
    ]
  }
}
